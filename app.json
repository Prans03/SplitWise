{
  "expo": {
    "name": "SplitWise",
    "slug": "SplitWise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "backgroundColor": "#151311",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.splitwise.app",
      "infoPlist": {
        "NSCameraUsageDescription": "SplitWise needs camera access to scan QR codes for joining groups and adding members."
      }
    },
    "android": {
      "package": "com.splitwise.app",
      "adaptiveIcon": {
        "backgroundColor": "#8DC63F",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "newArchEnabled": true
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "SplitWise needs camera access to scan QR codes for joining groups and adding members."
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ]
  }
}
